{
    "//": "Paths use %USERPROFILE% placeholders. Windows/install.ps1 expands them",
    "//2": "when copying this file into the Windows Terminal LocalState folder.",
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [
        {
            "command": {
                "action": "sendInput",
                "input": "\u001b[13;2u"
            },
            "id": "User.sendInput.ShiftEnter"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "down"
            },
            "id": "User.SplitPaneDown"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "right"
            },
            "id": "User.SplitPaneRight"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "down",
                "splitMode": "duplicate"
            },
            "id": "User.SplitPaneDownDup"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "right",
                "splitMode": "duplicate"
            },
            "id": "User.SplitPaneRightDup"
        },
        {
            "command": "closePane",
            "id": "User.ClosePane"
        },
        {
            "command": {
                "action": "moveFocus",
                "direction": "up"
            },
            "id": "User.FocusPaneUp"
        },
        {
            "command": {
                "action": "moveFocus",
                "direction": "down"
            },
            "id": "User.FocusPaneDown"
        },
        {
            "command": {
                "action": "moveFocus",
                "direction": "left"
            },
            "id": "User.FocusPaneLeft"
        },
        {
            "command": {
                "action": "moveFocus",
                "direction": "right"
            },
            "id": "User.FocusPaneRight"
        },
        {
            "command": {
                "action": "moveFocus",
                "direction": "previous"
            },
            "id": "User.MoveFocusPrev"
        },
        {
            "command": {
                "action": "moveFocus",
                "direction": "nextInOrder"
            },
            "id": "User.MoveFocusNext"
        },
        {
            "command": "duplicateTab",
            "id": "User.DuplicateCurrentTab"
        },
        {
            "command": "find",
            "id": "User.SearchScrollback"
        },
        {
            "command": "toggleFocusMode",
            "id": "User.ToggleFocusMode"
        },
        {
            "command": "toggleAlwaysOnTop",
            "id": "User.ToggleAlwaysOnTop"
        },
        {
            "command": "toggleShaderEffects",
            "id": "User.ToggleShader"
        }
    ],
    "alwaysShowNotificationIcon": false,
    "compatibility.allowHeadless": false,
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "initialCols": 135,
    "initialRows": 40,
    "keybindings": [
        {
            "id": null,
            "keys": "ctrl+c"
        },
        {
            "id": null,
            "keys": "ctrl+v"
        },
        {
            "id": null,
            "keys": "alt+shift+d"
        },
        {
            "id": null,
            "keys": "ctrl+alt+1"
        },
        {
            "id": null,
            "keys": "ctrl+alt+2"
        },
        {
            "id": null,
            "keys": "ctrl+alt+3"
        },
        {
            "id": null,
            "keys": "ctrl+alt+4"
        },
        {
            "id": null,
            "keys": "ctrl+alt+5"
        },
        {
            "id": null,
            "keys": "ctrl+alt+6"
        },
        {
            "id": null,
            "keys": "ctrl+alt+7"
        },
        {
            "id": null,
            "keys": "ctrl+alt+8"
        },
        {
            "id": null,
            "keys": "ctrl+alt+9"
        },
        {
            "id": "User.sendInput.ShiftEnter",
            "keys": "shift+enter"
        },
        {
            "id": "User.SplitPaneDown",
            "keys": "alt+shift+down"
        },
        {
            "id": "User.SplitPaneRight",
            "keys": "alt+shift+right"
        },
        {
            "id": "User.SplitPaneDownDup",
            "keys": "ctrl+alt+shift+down"
        },
        {
            "id": "User.SplitPaneRightDup",
            "keys": "ctrl+alt+shift+right"
        },
        {
            "id": "User.ClosePane",
            "keys": "ctrl+shift+w"
        },
        {
            "id": "User.FocusPaneUp",
            "keys": "alt+up"
        },
        {
            "id": "User.FocusPaneDown",
            "keys": "alt+down"
        },
        {
            "id": "User.FocusPaneLeft",
            "keys": "alt+left"
        },
        {
            "id": "User.FocusPaneRight",
            "keys": "alt+right"
        },
        {
            "id": "User.MoveFocusPrev",
            "keys": "ctrl+alt+left"
        },
        {
            "id": "User.MoveFocusNext",
            "keys": "ctrl+alt+right"
        },
        {
            "id": "User.DuplicateCurrentTab",
            "keys": "ctrl+shift+d"
        },
        {
            "id": "User.SearchScrollback",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "User.ToggleFocusMode",
            "keys": "shift+f11"
        },
        {
            "id": "User.ToggleAlwaysOnTop",
            "keys": "alt+shift+enter"
        },
        {
            "id": "User.ToggleShader",
            "keys": "ctrl+shift+g"
        }
    ],
    "language": "en-US",
    "newTabMenu": [
        {
            "type": "remainingProfiles"
        },
        {
            "type": "separator"
        }
    ],
    "profiles": {
