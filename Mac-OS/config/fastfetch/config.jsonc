{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": ": ",
    "color": {
      "keys":      "38;2;196;167;231",
      "title":     "38;2;255;170;223",
      "separator": "38;2;88;77;111"
    }
  },
  "modules": [
    { "type": "title" },
    { "type": "separator", "string": "─", "color": "38;2;88;77;111" },

    { "type": "os",       "key": "OS",       "outputColor": "38;2;156;207;216" },
    { "type": "host",     "key": "Host",     "outputColor": "38;2;246;193;119" },
    { "type": "kernel",   "key": "Kernel",   "outputColor": "38;2;235;188;186" },
    { "type": "uptime",   "key": "Uptime",   "outputColor": "38;2;235;111;146" },
    { "type": "packages", "key": "Packages", "outputColor": "38;2;184;153;255" },
    { "type": "shell",    "key": "Shell",    "outputColor": "38;2;156;207;216" },

    { "type": "display",  "key": "Display",  "outputColor": "38;2;255;170;223" },
    { "type": "wm",       "key": "WM",       "outputColor": "38;2;196;167;231" },
    { "type": "font",     "key": "Font",     "outputColor": "38;2;246;193;119" },

    { "type": "terminal",     "key": "Terminal",      "outputColor": "38;2;235;188;186" },
    { "type": "terminalfont", "key": "Terminal Font", "outputColor": "38;2;184;153;255" },

    { "type": "cpu",    "key": "CPU",      "outputColor": "38;2;246;193;119" },
    { "type": "gpu",    "key": "GPU",      "outputColor": "38;2;156;207;216" },
    { "type": "memory", "key": "Memory",   "outputColor": "38;2;235;111;146" },
    { "type": "disk",   "key": "Disk (/)", "folders": "/", "outputColor": "38;2;235;188;186" },

    { "type": "localip",  "key": "Local IP", "outputColor": "38;2;156;207;216" },
    { "type": "battery",  "key": "Battery",  "outputColor": "38;2;246;193;119" },
    { "type": "locale",   "key": "Locale",   "outputColor": "38;2;184;153;255" },

    { "type": "break" },
    { "type": "colors" }
  ]
}
