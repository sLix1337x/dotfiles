# Keep line endings correct no matter which platform commits.
# Shell scripts MUST be LF or macOS/Linux fails with "bad interpreter: ^M".
* text=auto eol=lf

*.sh        text eol=lf
*.zshrc     text eol=lf
*.bashrc    text eol=lf
Brewfile    text eol=lf

# PowerShell and batch files stay CRLF on Windows.
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Never touch binaries.
*.jpg  binary
*.jpeg binary
*.png  binary
*.ico  binary
*.ttf  binary
*.otf  binary
